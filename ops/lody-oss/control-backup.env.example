# Store the real file at /etc/lody-oss/control-backup.env with mode 0600.
RESTIC_REPOSITORY=sftp:lodycontrol@mac-mini:/restic/lody-oss-control
RESTIC_PASSWORD_FILE=/etc/lody-oss/control-restic-password
RESTIC_SFTP_COMMAND=ssh -i /etc/lody-oss/control-backup-ed25519 -o IdentitiesOnly=yes -o BatchMode=yes lodycontrol@mac-mini -s sftp
